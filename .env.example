# Landsight reads its keys from the environment. No key is needed to replay the recorded runs.
# To use your own keys: cp .env.example .env, fill in what you have, then add --env-file .env after `uv run`:
#   uv run --env-file .env python -m landsight serve --port 8795
# .env is git-ignored. Never commit it.

# Meta Model API: Muse Spark 1.3, SAM 3.1 and Muse Wonder.
MODEL_API_KEY=

# Baseten: Muse Spark Open, needed only for the private mode (--reader open).
BASETEN_API_KEY=

# Optional.
# LANDSIGHT_READER=open                 # use the private mode by default
# LANDSIGHT_OPEN_BASE_URL=              # another OpenAI-compatible server for Muse Spark Open
# LANDSIGHT_OPEN_MODEL=                 # its model id
# LANDSIGHT_OPEN_API_KEY=               # its key
# SSL_CERT_FILE=/etc/ssl/cert.pem       # if Python cannot verify the API's TLS certificate on macOS
